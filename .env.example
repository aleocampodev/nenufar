# ─── Vercel Blob (imágenes en producción) ───────────────────────
# Obtener en: https://vercel.com → tu proyecto → Storage → Blob → Create Store
# En dev local puedes dejarlo vacío — las imágenes se guardan en public/media/
BLOB_READ_WRITE_TOKEN=

# ─── Payload core ───────────────────────────────────────────────
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Local dev: point to your Postgres (Neon, Supabase, or local)
# Production: set DATABASE_URL in Vercel/Netlify dashboard
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/nenufar

# ─── Public URLs ────────────────────────────────────────────────
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─── Branding ───────────────────────────────────────────────────
COMPANY_NAME="Nénufar"
SITE_NAME="Nénufar"
TWITTER_CREATOR="@nenufar"
TWITTER_SITE="https://nenufar.co"

# ─── Draft preview ──────────────────────────────────────────────
PREVIEW_SECRET=change-me-for-draft-preview

# ─── Telegram (one-way order notification, replaces Stripe) ─────
# 
# CONFIGURACIÓN PASO A PASO:
# 
# 1. Crear el bot:
#    - Abrí Telegram y buscá @BotFather
#    - Enviá: /newbot
#    - Seguí las instrucciones (nombre: "Nénufar Pedidos", username: "nenufar_pedidos_bot")
#    - Copiá el token que te da BotFather (formato: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
#
# 2. Crear el canal de pedidos:
#    - En Telegram, creá un canal nuevo (público o privado)
#    - Nombre sugerido: "Pedidos Nenúfar"
#    - Si es público, elegí un username como @nenufarpedidos
#
# 3. Agregar el bot al canal:
#    - Abrí el canal → Configuración → Administradores → Agregar administrador
#    - Buscá tu bot por el username que creaste en paso 1
#    - Dale permisos de "Publicar mensajes" (Post messages)
#
# 4. Configurar las variables:
#    - TELEGRAM_BOT_TOKEN: el token del paso 1
#    - TELEGRAM_CHANNEL_ID: si el canal es público, usá @username (ej: @nenufarpedidos)
#                          si es privado, usá el ID numérico (lo obtenés con @userinfobot)
#
TELEGRAM_BOT_TOKEN=123456:ABC-DEF-your-bot-token
TELEGRAM_CHANNEL_ID=@nenufarpedidos

# ─── Webhook del bot de gestión de Shirley (sistema multiagente) ──
#
# El MISMO bot (TELEGRAM_BOT_TOKEN) recibe los mensajes de gestión de
# SHIRLEY vía webhook y ejecuta skills con el orquestador + Groq. No se
# necesita un bot separado. Las compradoras NO le escriben al bot: su
# recorrido es 100% web.
#
# Registrar el webhook (con la app corriendo + un túnel público):
#   cloudflared tunnel --url http://localhost:3002
#   pnpm tsx scripts/set-telegram-webhook.ts <https-url-del-tunel>
#
# Secreto que Telegram reenvía en el header X-Telegram-Bot-Api-Secret-Token.
# Generá uno con: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-string

# chat_id personal de Shirley — ÚNICO remitente que el bot procesa.
# Obtenelo escribiéndole a @userinfobot en Telegram.
TELEGRAM_ADMIN_CHAT_ID=123456789

# ─── Bot brain (Claude Agent SDK vía LiteLLM → Groq) ─────────────
# La app ya NO habla directo con Groq: el SDK del bot apunta al proxy local
# LiteLLM (:4000), que traduce Anthropic Messages API → Groq free tier.
# Política #253 ($0/mes) intacta — nunca se usa la API paga de Anthropic.
ANTHROPIC_BASE_URL=http://localhost:4000
# Debe coincidir con LITELLM_MASTER_KEY.
ANTHROPIC_AUTH_TOKEN=sk-nenufar-local
ANTHROPIC_MODEL=nenufar-bot
# Master key del proxy LiteLLM (genera una real con: openssl rand -hex 24)
LITELLM_MASTER_KEY=sk-nenufar-local

# ─── Groq (proveedor de inferencia, consumido SOLO por LiteLLM) ───
# API key gratis en https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key

# ─── Google Calendar (Sincronización automática de talleres y ferias) ───
# URL iCal (.ics) pública o privada del Google Calendar de Shirley
# Ejemplo: https://calendar.google.com/calendar/ical/shirley%40gmail.com/public/basic.ics
# (También configurable directamente desde /admin en el bloque de Talleres & Ferias)
GOOGLE_CALENDAR_ICAL_URL=
