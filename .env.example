# ─── Payload core ───────────────────────────────────────────────
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Local dev: point to your Postgres (Neon, Supabase, or local)
# Production: set DATABASE_URL in Vercel/Netlify dashboard
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/nenufar

# ─── Public URLs ────────────────────────────────────────────────
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─── Branding ───────────────────────────────────────────────────
COMPANY_NAME="Nénufar"
SITE_NAME="Nénufar"
TWITTER_CREATOR="@nenufar"
TWITTER_SITE="https://nenufar.co"

# ─── Draft preview ──────────────────────────────────────────────
PREVIEW_SECRET=change-me-for-draft-preview

# ─── Telegram (one-way order notification, replaces Stripe) ─────
# 
# CONFIGURACIÓN PASO A PASO:
# 
# 1. Crear el bot:
#    - Abrí Telegram y buscá @BotFather
#    - Enviá: /newbot
#    - Seguí las instrucciones (nombre: "Nénufar Pedidos", username: "nenufar_pedidos_bot")
#    - Copiá el token que te da BotFather (formato: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
#
# 2. Crear el canal de pedidos:
#    - En Telegram, creá un canal nuevo (público o privado)
#    - Nombre sugerido: "Pedidos Nenúfar"
#    - Si es público, elegí un username como @nenufarpedidos
#
# 3. Agregar el bot al canal:
#    - Abrí el canal → Configuración → Administradores → Agregar administrador
#    - Buscá tu bot por el username que creaste en paso 1
#    - Dale permisos de "Publicar mensajes" (Post messages)
#
# 4. Configurar las variables:
#    - TELEGRAM_BOT_TOKEN: el token del paso 1
#    - TELEGRAM_CHANNEL_ID: si el canal es público, usá @username (ej: @nenufarpedidos)
#                          si es privado, usá el ID numérico (lo obtenés con @userinfobot)
#
TELEGRAM_BOT_TOKEN=123456:ABC-DEF-your-bot-token
TELEGRAM_CHANNEL_ID=@nenufarpedidos
