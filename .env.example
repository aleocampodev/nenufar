# ─── Payload core ───────────────────────────────────────────────
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Local dev: point to your Postgres (Neon, Supabase, or local)
# Production: set DATABASE_URL in Vercel/Netlify dashboard
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/nenufar

# ─── Public URLs ────────────────────────────────────────────────
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─── Branding ───────────────────────────────────────────────────
COMPANY_NAME="Nénufar"
SITE_NAME="Nénufar"
TWITTER_CREATOR="@nenufar"
TWITTER_SITE="https://nenufar.co"

# ─── Draft preview ──────────────────────────────────────────────
PREVIEW_SECRET=change-me-for-draft-preview

# ─── Telegram (one-way order notification, replaces Stripe) ─────
# Create bot via @BotFather, get token, add bot as admin of channel
TELEGRAM_BOT_TOKEN=123456:ABC-DEF-your-bot-token
# Public channel username (e.g. @nenufarpedidos) or numeric chat ID
TELEGRAM_CHANNEL_ID=@nenufarpedidos
