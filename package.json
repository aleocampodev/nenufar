{
  "name": "nenufar-monorepo",
  "version": "2.1.0",
  "private": true,
  "description": "Nénufar — handmade jewelry solopreneur platform (storefront + CRM + Telegram command center). No LLM in runtime.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9",
  "scripts": {
    "dev": "pnpm --filter @nenufar/web dev",
    "build": "pnpm --filter @nenufar/web build",
    "start": "pnpm --filter @nenufar/web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9",
    "lint-staged": "^17"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "bash -c 'tsc --noEmit'"
    ]
  }
}